# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# print issue page PDFs, dropped in the repo root to be uploaded and never
# committed (see docs/print-issue-upload.md). Only the root is ignored, so
# PDFs the site actually serves from public/ are still tracked.
/*.pdf
/*.PDF

# debug
npm-debug.log*

# local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
.husky/post-checkout
.husky/post-commit
.husky/post-merge
.husky/pre-push
